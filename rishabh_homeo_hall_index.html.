<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#173f35">
<title>Rishabh Homeo Hall | Online Store</title>
<style>
:root{--green:#173f35;--green2:#245c4d;--cream:#f7f5ef;--ink:#1d2925;--muted:#68746e;--line:#e4e8e2;--gold:#c99a45}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:var(--ink);background:#fff}
a{color:inherit;text-decoration:none}button,input{font:inherit}.top{background:var(--green);color:#fff;text-align:center;padding:9px 14px;font-size:12px;letter-spacing:.3px}
header{border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:5}.nav{max-width:1160px;margin:auto;padding:17px 22px;display:flex;align-items:center;justify-content:space-between;gap:18px}
.brand{display:flex;align-items:center;gap:11px}.logo{width:43px;height:43px;border-radius:14px;background:var(--green);color:#fff;display:grid;place-items:center;font-size:22px}.brand strong{display:block;font-family:Georgia,serif;font-size:20px;color:var(--green)}.brand small{font-size:10px;letter-spacing:1.8px;color:var(--muted);text-transform:uppercase}
.navlinks{display:flex;gap:25px;font-size:13px;color:#45544d}.navlinks a:hover{color:var(--gold)}.cartbtn{border:1px solid var(--line);background:#fff;border-radius:30px;padding:10px 15px;cursor:pointer;color:var(--green);font-weight:650}
.hero{background:linear-gradient(110deg,#f4f2e9 0%,#f8f7f2 57%,#e8eee6 100%);overflow:hidden}.hero-inner{max-width:1160px;margin:auto;padding:72px 22px 68px;display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:30px}
.eyebrow{color:var(--green2);font-size:11px;font-weight:750;letter-spacing:2px;text-transform:uppercase}.hero h1{font:clamp(40px,5vw,64px)/1.04 Georgia,serif;color:var(--green);max-width:600px;margin:17px 0}.hero p{max-width:510px;color:#58665f;line-height:1.75;font-size:15px}.primary{display:inline-block;background:var(--green);color:#fff;padding:14px 22px;border:0;border-radius:4px;font-weight:650;cursor:pointer;margin-top:13px}.primary:hover{background:var(--green2)}
.hero-art{min-height:280px;display:grid;place-items:center;position:relative}.circle{width:min(340px,75vw);aspect-ratio:1;border-radius:50%;background:#dce6d9;display:grid;place-items:center;box-shadow:inset 0 0 0 18px #e9eee5}.bottle{width:112px;height:175px;background:linear-gradient(90deg,#c7a66d,#ead8ad,#b38d50);border-radius:15px 15px 22px 22px;position:relative;box-shadow:18px 20px 25px #72806a33;transform:rotate(-7deg)}.bottle:before{content:"";position:absolute;width:53px;height:27px;background:#735b3c;top:-22px;left:30px;border-radius:5px 5px 2px 2px}.bottle:after{content:"RISHABH\\A HOMEO HALL";white-space:pre;position:absolute;top:57px;left:10px;right:10px;background:#f8f4e8;color:#315344;text-align:center;padding:17px 3px;font: bold 10px/1.5 Georgia,serif;letter-spacing:1px}.leaf{position:absolute;font-size:78px;opacity:.55}.leaf.one{left:8%;top:12%;transform:rotate(-28deg)}.leaf.two{right:4%;bottom:8%;transform:rotate(30deg)}
.trust{max-width:1160px;margin:auto;padding:23px 22px;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;border-bottom:1px solid var(--line)}.trust div{text-align:center;font-size:12px;color:var(--muted)}.trust b{display:block;color:var(--green);font-size:13px;margin-bottom:4px}
.section{max-width:1160px;margin:auto;padding:58px 22px}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.section h2{font:36px Georgia,serif;color:var(--green);margin:8px 0}.section-head p{color:var(--muted);font-size:13px;margin:0}
.tools{display:flex;gap:10px;margin-bottom:22px}.tools input,.tools select{border:1px solid var(--line);border-radius:5px;padding:12px;background:#fff;min-width:0}.tools input{flex:1}
.products{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.product{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}.product-visual{height:170px;background:#f4f5ef;display:grid;place-items:center;font-size:55px}.product-info{padding:16px}.tag{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--green2);font-weight:750}.product h3{font:19px Georgia,serif;margin:8px 0;color:var(--ink)}.product p{font-size:12px;line-height:1.5;color:var(--muted);min-height:36px}.price-row{display:flex;justify-content:space-between;align-items:center;margin-top:14px}.price{font-weight:750;color:var(--green)}.add{background:#fff;border:1px solid var(--green);color:var(--green);border-radius:4px;padding:8px 11px;font-size:12px;font-weight:700;cursor:pointer}.add:hover{background:var(--green);color:white}
.note{background:var(--cream);padding:28px;border-radius:8px;display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.note h2{font:28px Georgia,serif;color:var(--green);margin:0 0 8px}.note p{font-size:13px;line-height:1.7;color:var(--muted);margin:0}
footer{background:#142f28;color:#eaf0eb;margin-top:40px}.footer-inner{max-width:1160px;margin:auto;padding:42px 22px;display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px}.footer-inner h3{font:22px Georgia,serif;margin:0 0 12px}.footer-inner p,.footer-inner a{font-size:12px;line-height:1.9;color:#c3d0c8;display:block}.copyright{border-top:1px solid #ffffff22;padding:15px 22px;text-align:center;font-size:11px;color:#b8c8be}
.drawer{position:fixed;inset:0;background:#0007;z-index:10;display:none;justify-content:flex-end}.drawer.open{display:flex}.panel{background:white;width:min(420px,100%);height:100%;padding:23px;overflow:auto}.panel-head{display:flex;justify-content:space-between;align-items:center}.panel h2{font:27px Georgia,serif;color:var(--green)}.close{border:0;background:#f0f2ed;border-radius:50%;width:36px;height:36px;cursor:pointer}.cart-line{display:flex;justify-content:space-between;gap:12px;padding:15px 0;border-bottom:1px solid var(--line);font-size:13px}.cart-line small{display:block;color:var(--muted);margin-top:4px}.qty{display:flex;align-items:center;gap:8px}.qty button{border:1px solid var(--line);background:#fff;border-radius:4px;width:25px;height:25px;cursor:pointer}.total{display:flex;justify-content:space-between;font-weight:750;margin:22px 0}.checkout{width:100%;text-align:center}.empty{color:var(--muted);padding:35px 0;text-align:center;font-size:14px}
@media(max-width:760px){.navlinks{display:none}.hero-inner{grid-template-columns:1fr;padding-top:48px}.hero-art{min-height:220px}.trust{grid-template-columns:1fr;gap:13px}.products{grid-template-columns:repeat(2,1fr)}.section-head{display:block}.note{grid-template-columns:1fr}.footer-inner{grid-template-columns:1fr 1fr}.footer-inner>div:first-child{grid-column:1/-1}}
@media(max-width:420px){.products{grid-template-columns:1fr 1fr;gap:10px}.product-visual{height:130px}.product-info{padding:11px}.product h3{font-size:16px}.product p{font-size:11px}.add{padding:7px}.hero h1{font-size:42px}}
</style>
</head>
<body>
<div class="top">WELCOME TO RISHABH HOMEO HALL · ONLINE STORE</div>
<header><nav class="nav">
  <a class="brand" href="#"><span class="logo">✚</span><span><strong>Rishabh Homeo Hall</strong><small>Care • Wellness • Service</small></span></a>
  <div class="navlinks"><a href="#home">Home</a><a href="#shop">Shop</a><a href="#about">About</a><a href="#contact">Contact</a></div>
  <button class="cartbtn" onclick="openCart()">Bag (<span id="cartCount">0</span>)</button>
</nav></header>
<main>
<section class="hero" id="home"><div class="hero-inner">
  <div><div class="eyebrow">Welcome to our online store</div><h1>Thoughtful care, made easier.</h1><p>Discover the Rishabh Homeo Hall collection. Browse our products, add your selections to the bag, and place an enquiry directly with our store.</p><a class="primary" href="#shop">Explore products&nbsp; →</a></div>
  <div class="hero-art"><span class="leaf one">✦</span><div class="circle"><div class="bottle"></div></div><span class="leaf two">❧</span></div>
</div></section>
<div class="trust"><div><b>Carefully selected</b>Product information in one place</div><div><b>Easy ordering</b>Send your order enquiry online</div><div><b>Personal assistance</b>Connect with our store team</div></div>
<section class="section" id="shop"><div class="section-head"><div><div class="eyebrow">The store</div><h2>Shop our products</h2><p>Search the catalogue and add items to your bag.</p></div></div>
  <div class="tools"><input id="search" type="search" placeholder="Search products…" oninput="renderProducts()"><select id="category" onchange="renderProducts()"><option value="all">All categories</option><option value="Dilutions">Dilutions</option><option value="Mother tinctures">Mother tinctures</option><option value="Personal care">Personal care</option><option value="Other">Other</option></select></div>
  <div class="products" id="products"></div>
</section>
<section class="section" id="about"><div class="note"><div><div class="eyebrow">Rishabh Homeo Hall</div><h2>Here to help you shop with confidence.</h2></div><p>We are building our online catalogue to make browsing and ordering convenient. For product suitability, dosage, or treatment advice, please consult a qualified healthcare professional. Product availability and final prices should be confirmed by the store.</p></div></section>
</main>
<footer id="contact"><div class="footer-inner">
  <div><h3>Rishabh Homeo Hall</h3><p>Your store information goes here. Add your address, business hours, and a short introduction so customers know how to reach you.</p></div>
  <div><h3>Quick links</h3><a href="#home">Home</a><a href="#shop">Shop products</a><a href="#about">About us</a></div>
  <div><h3>Contact</h3><p>Phone: Add your number<br>Email: Add your email<br>Address: Add store address</p></div>
</div><div class="copyright">© <span id="year"></span> Rishabh Homeo Hall. All rights reserved.</div></footer>
<div class="drawer" id="drawer" onclick="if(event.target===this)closeCart()"><div class="panel"><div class="panel-head"><h2>Your bag</h2><button class="close" onclick="closeCart()">✕</button></div><div id="cartItems"></div><div id="cartBottom"></div></div></div>
<script>
// DEMO CATALOGUE: replace these sample entries with your actual products and verified prices.
const products=[
 {id:1,name:"Sample Dilution",category:"Dilutions",desc:"Replace with the exact product name and details.",price:0,icon:"🧴"},
 {id:2,name:"Sample Mother Tincture",category:"Mother tinctures",desc:"Add the correct pack size and product description.",price:0,icon:"🌿"},
 {id:3,name:"Sample Personal Care",category:"Personal care",desc:"Replace with an item from your approved catalogue.",price:0,icon:"🍃"},
 {id:4,name:"Sample Homeo Product",category:"Other",desc:"Add your product details and confirmed selling price.",price:0,icon:"📦"}
];
const cart={};
function money(n){return "₹"+Number(n).toLocaleString("en-IN")}
function renderProducts(){
 const q=document.getElementById("search").value.toLowerCase(),cat=document.getElementById("category").value;
 const list=products.filter(p=>(cat==="all"||p.category===cat)&&(p.name+" "+p.category+" "+p.desc).toLowerCase().includes(q));
 document.getElementById("products").innerHTML=list.map(p=>`<article class="product"><div class="product-visual">${p.icon}</div><div class="product-info"><span class="tag">${p.category}</span><h3>${p.name}</h3><p>${p.desc}</p><div class="price-row"><span class="price">${p.price?money(p.price):"Price to confirm"}</span><button class="add" onclick="addToCart(${p.id})">Add to bag +</button></div></div></article>`).join("")||"<p>No products found. Try another search.</p>";
}
function addToCart(id){cart[id]=(cart[id]||0)+1;updateCart();openCart()}
function updateCart(){
 const count=Object.values(cart).reduce((a,b)=>a+b,0);document.getElementById("cartCount").textContent=count;
 const entries=products.filter(p=>cart[p.id]);const area=document.getElementById("cartItems"),bottom=document.getElementById("cartBottom");
 if(!entries.length){area.innerHTML='<div class="empty">Your bag is empty.<br>Explore the catalogue to add products.</div>';bottom.innerHTML="";return}
 area.innerHTML=entries.map(p=>`<div class="cart-line"><div><b>${p.name}</b><small>${p.price?money(p.price):"Price to confirm"}</small></div><div class="qty"><button onclick="changeQty(${p.id},-1)">−</button>${cart[p.id]}<button onclick="changeQty(${p.id},1)">+</button></div></div>`).join("");
 const priced=entries.every(p=>p.price>0),total=entries.reduce((s,p)=>s+p.price*cart[p.id],0);
 bottom.innerHTML=`<div class="total"><span>${priced?"Estimated total":"Total"} </span><span>${priced?money(total):"To be confirmed"}</span></div><button class="primary checkout" onclick="checkout()">Enquire on WhatsApp</button><p style="font-size:11px;color:#68746e;line-height:1.5">Prices, availability, shipping, and order acceptance will be confirmed by the store.</p>`;
}
function changeQty(id,d){cart[id]=(cart[id]||0)+d;if(cart[id]<=0)delete cart[id];updateCart()}
function openCart(){document.getElementById("drawer").classList.add("open");updateCart()}
function closeCart(){document.getElementById("drawer").classList.remove("open")}
function checkout(){
 // Replace with the store's WhatsApp number in international format, digits only (India: 91XXXXXXXXXX).
 const whatsappNumber="91XXXXXXXXXX";
 if(whatsappNumber.includes("X")){alert("Store setup needed: add your WhatsApp number in the website code before accepting orders.");return}
 const lines=products.filter(p=>cart[p.id]).map(p=>`${p.name} x ${cart[p.id]} — ${p.price?money(p.price):"price to confirm"}`);
 const msg="Hello Rishabh Homeo Hall, I would like to enquire about:\n"+lines.join("\n")+"\nPlease confirm availability, final price and delivery.";
 window.open("https://wa.me/"+whatsappNumber+"?text="+encodeURIComponent(msg),"_blank");
}
document.getElementById("year").textContent=new Date().getFullYear();renderProducts();updateCart();
</script>
</body></html>
